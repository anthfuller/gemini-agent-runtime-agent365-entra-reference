# Placeholder configuration only.
# Copy this file to .env for local use. Never commit the populated .env file.

# Google Cloud and Agent Runtime
GOOGLE_CLOUD_PROJECT=YOUR_GOOGLE_CLOUD_PROJECT_ID
GOOGLE_CLOUD_LOCATION=YOUR_GOOGLE_CLOUD_REGION
GOOGLE_AGENT_RUNTIME_RESOURCE_NAME=projects/YOUR_PROJECT_NUMBER/locations/YOUR_REGION/reasoningEngines/YOUR_REASONING_ENGINE_ID
GOOGLE_AGENT_RUNTIME_STAGING_BUCKET=gs://YOUR_STAGING_BUCKET
GOOGLE_AGENT_DISPLAY_NAME=YOUR_AGENT_DISPLAY_NAME
GOOGLE_ADK_AGENT_NAME=YOUR_VALID_ADK_AGENT_NAME
GOOGLE_AGENT_MODEL=YOUR_VALIDATED_GEMINI_MODEL

# Cross-cloud token exchange
GOOGLE_TOKEN_AUDIENCE=api://AzureADTokenExchange
ENTRA_TOKEN_SCOPE=api://AzureADTokenExchange/.default

# Microsoft Entra Agent ID
ENTRA_TENANT_ID=YOUR_ENTRA_TENANT_ID
ENTRA_BLUEPRINT_APP_ID=YOUR_AGENT_IDENTITY_BLUEPRINT_APP_ID
APPROVED_AGENT_ID=YOUR_APPROVED_CHILD_AGENT_ID
DENIED_AGENT_ID=YOUR_DENIED_CHILD_AGENT_ID

# Protected API and validation
PROTECTED_API_APP_ID=YOUR_PROTECTED_API_APP_ID
PROTECTED_API_AUDIENCE=api://YOUR_PROTECTED_API_APP_ID
PROTECTED_API_SCOPE=api://YOUR_PROTECTED_API_APP_ID/.default
PROTECTED_API_BASE_URL=https://YOUR_PROTECTED_API_HOST
PROTECTED_API_REQUIRED_ROLE=Investigation.Read
INVESTIGATION_ID=LAB-001
INVOKE_USER_ID=YOUR_NON_SENSITIVE_DIAGNOSTIC_USER_ID
PORT=YOUR_API_PORT
